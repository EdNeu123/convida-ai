rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /invites/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /rsvps/{rsvpId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name','status','recado','ts'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 120
          && request.resource.data.status in ['accept','decline']
          && request.resource.data.recado is string && request.resource.data.recado.size() < 500;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
